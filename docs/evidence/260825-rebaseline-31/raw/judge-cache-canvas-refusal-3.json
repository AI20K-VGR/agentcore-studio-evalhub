{"HB2-04": {"Tôi không có thông tin về thời gian nghỉ lễ Tết Nguyên Đán của nhân viên trong tài liệu Callisto. Nếu bạn cần biết thông tin này, vui lòng tham khảo các nguồn khác hoặc tài liệu cụ thể về chính sách nghỉ lễ của công ty.": false}, "HB2-05": {"Bảo hiểm sức khoẻ có hạn mức nội trú là 50.000.000 VNĐ/năm [ankor-hr-benefits#c1].": true}, "HB2-06": {"Bảo hiểm sức khoẻ có hạn mức nội trú là 100.000.000 VNĐ/năm [borea-hr-benefits#c1].": true}, "HB2-07": {"Sự cố P1 cần được bắt đầu xử lý trong vòng 15 phút sau khi được acknowledge trong 5 phút [ankor-engineering-incident#c6].": false}, "HB2-08": {"Sự cố P1 cần được bắt đầu xử lý trong vòng 3 phút để xác nhận (acknowledge) và trong 10 phút để thực hiện các bước tham gia (engage), với mục tiêu giải quyết trong 30 phút [borea-engineering-oncall#c4].": true}, "HB2-13": {"Chi phí ăn uống công tác nội thành được hoàn ứng tối đa 200.000 VNĐ/bữa [ankor-finance-reimbursement#c2].": true}, "HB2-15": {"Đánh giá hiệu suất diễn ra 2 lần một năm: giữa năm (tháng 6) và cuối năm (tháng 12) [ankor-hr-performance#c1].": true}, "HB2-18": {"Phụ cấp on-call vào ngày thường là 1.500.000 VNĐ/tuần [ankor-engineering-oncall#c3].": true}, "HB2-20": {"Team Lead được phê duyệt chi phí vận hành dưới 10.000.000 VNĐ một giao dịch [ankor-finance-approval-limits#c2].": true}, "HB2-21": {"Ngân sách đào tạo mỗi nhân viên một năm là 10.000.000 VNĐ. [ankor-hr-training#c1]": true}, "HB2-22": {"Nhân viên được nghỉ 3 ngày trong dịp lễ Quốc khánh, từ 1 đến 3 tháng 9 [borea-public-holidays#c2].": true}}