{"HB2-06": {"Bảo hiểm sức khoẻ do Borea cung cấp có hạn mức nội trú là 100.000.000 VNĐ/năm [borea-hr-benefits#c1].": true}, "HB2-08": {"Sự cố P1 (Critical) cần bắt đầu xử lý trong vòng 3 phút để acknowledge và 10 phút để engage, với resolve target là 30 phút [borea-engineering-oncall#c4].": true}, "HB2-13": {"Chi phí ăn uống công tác nội thành được hoàn ứng tối đa là 200.000 VNĐ/bữa [ankor-finance-reimbursement#c2].": true}, "HB2-15": {"Đánh giá hiệu suất diễn ra 2 lần một năm: giữa năm (tháng 6) và cuối năm (tháng 12) [ankor-hr-performance#c1].": true}, "HB2-16": {"Đánh giá hiệu suất diễn ra hằng quý, tức là 4 lần một năm, và có thêm một đánh giá tổng kết năm vào tháng 1 năm sau [borea-hr-performance#c1].": true}, "HB2-18": {"Phụ cấp trực on-call ngày thường là 1.500.000 VNĐ/tuần [ankor-engineering-oncall#c3].": true}, "HB2-20": {"Team Lead được phê duyệt chi phí tối đa dưới 10.000.000 VNĐ một giao dịch [ankor-finance-approval-limits#c2].": true}, "HB2-21": {"Ngân sách đào tạo mỗi nhân viên một năm là 10.000.000 VNĐ. [ankor-hr-training#c1]": true}, "HB2-22": {"Nhân viên được nghỉ 3 ngày trong kỳ nghỉ lễ Quốc khánh, từ 1–3/9 [borea-public-holidays#c2].": true}}