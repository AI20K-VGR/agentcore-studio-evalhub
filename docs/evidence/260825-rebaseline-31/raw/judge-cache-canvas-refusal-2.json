{"HB2-04": {"Không có thông tin.": false}, "HB2-05": {"Bảo hiểm sức khoẻ có hạn mức nội trú là 50.000.000 VNĐ/năm [ankor-hr-benefits#c1].": true}, "HB2-06": {"Bảo hiểm sức khoẻ của Borea có hạn mức nội trú là 100.000.000 VNĐ/năm. [borea-hr-benefits#c1]": true}, "HB2-08": {"Sự cố P1 (Critical) cần được xử lý trong 3 phút để xác nhận (acknowledge) và trong 10 phút để tham gia vào việc xử lý (engage), với mục tiêu giải quyết sự cố trong vòng 30 phút [borea-engineering-oncall#c4].": true}, "HB2-13": {"Chi phí ăn uống công tác nội thành được hoàn ứng tối đa là 200.000 VNĐ/bữa [ankor-finance-reimbursement#c2].": true}, "HB2-15": {"Đánh giá hiệu suất diễn ra 2 lần một năm: giữa năm (tháng 6) và cuối năm (tháng 12) [ankor-hr-performance#c1].": true}, "HB2-16": {"Đánh giá hiệu suất diễn ra 4 lần một năm, một lần cho mỗi quý (Q1–Q4), và có thêm một đánh giá tổng kết vào tháng 1 năm sau [borea-hr-performance#c1].": true}, "HB2-18": {"Phụ cấp trực on-call vào ngày thường là 1.500.000 VNĐ/tuần [ankor-engineering-oncall#c3].": true}, "HB2-19": {"Không có thông tin về ngày lương được trả trong các tài liệu liên quan đến Callisto.": false}, "HB2-20": {"Team Lead được phê duyệt chi phí vận hành tối đa dưới 10.000.000 VNĐ một giao dịch [ankor-finance-approval-limits#c2].": true}, "HB2-21": {"Ngân sách đào tạo mỗi nhân viên một năm là 10.000.000 VNĐ [ankor-hr-training#c1].": true}, "HB2-22": {"Tôi không có thông tin về lễ Quốc khánh và số ngày nghỉ của nhân viên trong tài liệu Callisto.": false}}