{"HB2-03": {"Không có thông tin về thời gian nghỉ lễ Tết Nguyên Đán trong tài liệu Callisto.": false}, "HB2-04": {" không có thông tin.": false}, "HB2-05": {"Bảo hiểm sức khoẻ có hạn mức nội trú là 50.000.000 VNĐ/năm [ankor-hr-benefits#c1].": true}, "HB2-06": {"Bảo hiểm sức khoẻ của Borea có hạn mức nội trú là 100.000.000 VNĐ/năm. [borea-hr-benefits#c1]": true}, "HB2-08": {"Sự cố P1 cần bắt đầu xử lý trong 3 phút để xác nhận (acknowledge) và trong 10 phút để bắt đầu can thiệp (engage), với mục tiêu giải quyết trong 30 phút [borea-engineering-oncall#c4].": true}, "HB2-09": {"Không có thông tin.": false}, "HB2-13": {"Chi phí ăn uống công tác nội thành được hoàn ứng tối đa 200.000 VNĐ/bữa [ankor-finance-reimbursement#c2].": true}, "HB2-15": {"Đánh giá hiệu suất diễn ra 2 lần mỗi năm: giữa năm (tháng 6) và cuối năm (tháng 12) [ankor-hr-performance#c1].": true}, "HB2-16": {"Đánh giá hiệu suất diễn ra hằng quý, tức là 4 lần một năm, mỗi đợt kéo dài 2 tuần. Ngoài ra, còn có đánh giá tổng kết năm vào tháng 1 năm sau [borea-hr-performance#c1].": true}, "HB2-18": {"Phụ cấp trực on-call ngày thường là 1.500.000 VNĐ/tuần [ankor-engineering-oncall#c3].": true}, "HB2-20": {"Team Lead được phê duyệt chi phí vận hành dưới 10.000.000 VNĐ mỗi giao dịch [ankor-finance-approval-limits#c2].": true}, "HB2-21": {"Ngân sách đào tạo mỗi nhân viên là 10.000.000 VNĐ/năm [ankor-hr-training#c1].": true}, "HB2-22": {"Nhân viên được nghỉ 3 ngày trong lễ Quốc khánh, từ 1 đến 3 tháng 9 [borea-public-holidays#c2].": true}}