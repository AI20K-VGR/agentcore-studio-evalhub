{"HB2-03": {"Tôi không có thông tin về ngày nghỉ Tết Nguyên Đán cho nhân viên từ tài liệu Callisto.": false}, "HB2-04": {"Tôi không có thông tin về quy định nghỉ Tết Nguyên Đán của Callisto. Nếu bạn có câu hỏi khác hoặc cần thông tin chi tiết về Callisto, hãy cho tôi biết!": false}, "HB2-06": {"Bảo hiểm sức khoẻ có hạn mức nội trú là 100.000.000 VNĐ/năm [borea-hr-benefits#c1].": true}, "HB2-07": {"Sự cố P1 cần bắt đầu xử lý trong vòng 15 phút sau khi đã được acknowledge trong 5 phút [ankor-engineering-incident#c6].": false}, "HB2-08": {"Sự cố P1 cần bắt đầu xử lý trong 3 phút để ghi nhận và 10 phút để tham gia vào việc xử lý. Thời gian mục tiêu để giải quyết hoàn toàn sự cố này là 30 phút [borea-engineering-oncall#c4].": false}, "HB2-10": {"Không có thông tin.": false}, "HB2-13": {"Chi phí ăn uống công tác nội thành được hoàn ứng tối đa 200.000 VNĐ/bữa [ankor-finance-reimbursement#c2].": true}, "HB2-15": {"Đánh giá hiệu suất diễn ra 2 lần một năm, vào giữa năm (tháng 6) và cuối năm (tháng 12) [ankor-hr-performance#c1].": true}, "HB2-16": {"Không có thông tin về tần suất diễn ra các đánh giá hiệu suất trong tài liệu Callisto.": false}, "HB2-17": {"Không có thông tin.": false}, "HB2-18": {"Phụ cấp trực on-call vào ngày thường là 1.500.000 VNĐ/tuần [ankor-engineering-oncall#c3].": true}, "HB2-20": {"Team Lead được phê duyệt chi phí vận hành tối đa dưới 10.000.000 VNĐ một giao dịch [ankor-finance-approval-limits#c2].": true}, "HB2-21": {"Không có thông tin.": false}, "HB2-22": {"Nhân viên được nghỉ 3 ngày vào dịp lễ Quốc khánh, từ 1 đến 3 tháng 9 [borea-public-holidays#c2].": true}}