{"HB2-06": {"Bảo hiểm sức khoẻ có hạn mức nội trú là 100.000.000 VNĐ/năm [borea-hr-benefits#c1].": true}, "HB2-08": {"Sự cố P1 cần được xử lý trong thời gian tối đa là 30 phút để khôi phục dịch vụ, với thời gian ghi nhận là 3 phút và thời gian tham gia là 10 phút [borea-engineering-oncall#c4].": false}, "HB2-13": {"Chi phí ăn uống công tác nội thành được hoàn ứng tối đa là 200.000 VNĐ/bữa [ankor-finance-reimbursement#c2].": true}, "HB2-15": {"Đánh giá hiệu suất diễn ra 2 lần một năm: giữa năm (tháng 6) và cuối năm (tháng 12) [ankor-hr-performance#c1].": true}, "HB2-16": {"Đánh giá hiệu suất diễn ra hằng quý (4 lần một năm), mỗi đợt kéo dài 2 tuần và có thêm một đánh giá tổng kết năm vào tháng 1 năm sau [borea-hr-performance#c1].": true}, "HB2-18": {"Phụ cấp trực on-call ngày thường là 1.500.000 VNĐ/tuần [ankor-engineering-oncall#c3].": true}, "HB2-20": {"Team Lead được phê duyệt chi phí vận hành tối đa dưới 10.000.000 VNĐ một giao dịch [ankor-finance-approval-limits#c2].": true}, "HB2-21": {"Ngân sách đào tạo mỗi nhân viên một năm là 10.000.000 VNĐ. [ankor-hr-training#c1]": true}, "HB2-22": {"Nhân viên được nghỉ 3 ngày trong dịp lễ Quốc khánh, từ 1 đến 3 tháng 9 [borea-public-holidays#c2].": true}}