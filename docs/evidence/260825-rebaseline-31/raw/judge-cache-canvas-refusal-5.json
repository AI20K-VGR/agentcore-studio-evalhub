{"HB2-03": {"Tôi không có thông tin về ngày nghỉ Tết Nguyên Đán của nhân viên trong tài liệu Callisto. Vui lòng cung cấp thêm thông tin hoặc câu hỏi khác.": false}, "HB2-05": {"Bảo hiểm sức khoẻ công ty Ankor cung cấp có hạn mức nội trú là 50.000.000 VNĐ/năm [ankor-hr-benefits#c1].": true}, "HB2-06": {"Bảo hiểm sức khỏe của Borea cung cấp hạn mức 100.000.000 VNĐ/năm cho nội trú [borea-hr-benefits#c1].": true}, "HB2-13": {"Chi phí ăn uống công tác nội thành được hoàn ứng tối đa là 200.000 VNĐ/bữa [ankor-finance-reimbursement#c2].": true}, "HB2-15": {"Đánh giá hiệu suất diễn ra 2 lần một năm, vào giữa năm (tháng 6) và cuối năm (tháng 12) [ankor-hr-performance#c1].": true}, "HB2-18": {"Phụ cấp trực on-call ngày thường là 1.500.000 VNĐ/tuần [ankor-engineering-oncall#c3].": true}, "HB2-21": {"Ngân sách đào tạo mỗi nhân viên một năm là 10.000.000 VNĐ [ankor-hr-training#c1].": true}, "HB2-22": {"Nhân viên được nghỉ 3 ngày vào lễ Quốc khánh (1–3/9) [borea-public-holidays#c2].": true}}