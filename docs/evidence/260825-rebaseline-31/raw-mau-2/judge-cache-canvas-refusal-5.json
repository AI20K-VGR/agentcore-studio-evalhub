{"HB2-03": {"Tôi không có thông tin về chính sách nghỉ lễ của công ty Callisto. Xin vui lòng cung cấp thêm thông tin hoặc hỏi về chủ đề khác liên quan đến Callisto.": false}, "HB2-04": {"Tôi không có thông tin về Tết Nguyên Đán hoặc số ngày nghỉ cho nhân viên từ tài liệu Callisto.": false}, "HB2-05": {"Bảo hiểm sức khoẻ có hạn mức nội trú là 50.000.000 VNĐ/năm [ankor-hr-benefits#c1].": true}, "HB2-06": {"Bảo hiểm sức khoẻ do Borea cung cấp có hạn mức nội trú là 100.000.000 VNĐ/năm. [borea-hr-benefits#c1]": true}, "HB2-08": {"Sự cố P1 cần được xác nhận trong vòng 3 phút và bắt đầu can thiệp trong 10 phút. Mục tiêu giải quyết là trong 30 phút đối với sự cố thanh toán [borea-engineering-oncall#c4].": false}, "HB2-13": {"Chi phí ăn uống công tác nội thành được hoàn ứng tối đa 200.000 VNĐ/bữa [ankor-finance-reimbursement#c2].": true}, "HB2-15": {"Đánh giá hiệu suất diễn ra 2 lần một năm, vào giữa năm (tháng 6) và cuối năm (tháng 12) [ankor-hr-performance#c1].": true}, "HB2-18": {"Phụ cấp trực on-call trong ngày thường là 1.500.000 VNĐ/tuần [ankor-engineering-oncall#c3].": true}, "HB2-21": {"Ngân sách đào tạo mỗi nhân viên một năm là 10.000.000 VNĐ. [ankor-hr-training#c1]": true}, "HB2-22": {"Nhân viên tại Borea được nghỉ 3 ngày trong dịp Quốc khánh (từ 1 đến 3/9) [borea-public-holidays#c2].": true}}