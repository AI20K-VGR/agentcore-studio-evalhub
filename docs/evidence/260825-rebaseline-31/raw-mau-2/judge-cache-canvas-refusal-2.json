{"HB2-04": {"Không có thông tin về Tết Nguyên Đán và ngày nghỉ của nhân viên trong tài liệu Callisto.": false}, "HB2-06": {"Bảo hiểm sức khoẻ của Borea có hạn mức 100.000.000 VNĐ/năm cho nội trú và 30.000.000 VNĐ/năm cho ngoại trú [borea-hr-benefits#c1].": true}, "HB2-08": {"Sự cố P1 cần được xử lý với thời gian phản hồi là 3 phút để xác nhận, 10 phút để tham gia, và mục tiêu giải quyết trong vòng 30 phút [borea-engineering-oncall#c4].": false}, "HB2-09": {"Tôi không tìm thấy thông tin về thời gian nộp đơn xin nghỉ phép trong tài liệu Callisto.": false}, "HB2-10": {"Tôi sẽ tra cứu tài liệu Callisto để tìm thông tin về thời gian nộp đơn xin nghỉ phép. \n\nTOOL_CALL: {\"tool\": \"kb_search\", \"params\": {\"query\": \"đơn xin nghỉ phép nộp trước bao lâu\"}}": false}, "HB2-13": {"Không có thông tin.": false}, "HB2-15": {"Đánh giá hiệu suất diễn ra 2 lần mỗi năm: giữa năm (tháng 6) và cuối năm (tháng 12) [ankor-hr-performance#c1].": true}, "HB2-18": {"Phụ cấp trực on-call ngày thường là 1.500.000 VNĐ/tuần [ankor-engineering-oncall#c3].": true}, "HB2-20": {"Team Lead được phê duyệt chi phí vận hành dưới 10.000.000 VNĐ một giao dịch [ankor-finance-approval-limits#c2].": true}, "HB2-21": {"Không có thông tin về ngân sách đào tạo mỗi nhân viên một năm trong tài liệu Callisto.": false}, "HB2-22": {"Không có thông tin về lễ Quốc khánh và số ngày nghỉ của nhân viên trong tài liệu Callisto.": false}}