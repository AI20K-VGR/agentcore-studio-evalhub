{"HB2-06": {"Bảo hiểm sức khoẻ của Borea có hạn mức nội trú là 100.000.000 VNĐ/năm [borea-hr-benefits#c1].": true}, "HB2-08": {"Sự cố P1 cần được xử lý trong thời gian nhất định: cần phải phản hồi trong vòng 3 phút, bắt đầu tham gia trong 10 phút và mục tiêu giải quyết là trong 30 phút [borea-engineering-oncall#c4].": false}, "HB2-12": {"Quy trình mua sắm áp dụng cho giao dịch bắt đầu từ 30 triệu trở lên, với các mức phê duyệt khác nhau tùy theo giá trị giao dịch. Cụ thể, dưới 30 triệu được phê duyệt bởi team lead, từ 30–100 triệu bởi VP, từ 100–500 triệu bởi CFO, và trên 500 triệu bởi CEO cùng Board [borea-finance-procurement#c4].": false}, "HB2-13": {"Chi phí ăn uống công tác nội thành được hoàn ứng tối đa 200.000 VNĐ/bữa [ankor-finance-reimbursement#c2].": true}, "HB2-15": {"Đánh giá hiệu suất diễn ra 2 lần một năm, vào giữa năm (tháng 6) và cuối năm (tháng 12) [ankor-hr-performance#c1].": true}, "HB2-16": {"Đánh giá hiệu suất diễn ra hằng quý, tức là 4 lần một năm (Q1–Q4), mỗi đợt kéo dài 2 tuần. Ngoài ra, còn có đánh giá tổng kết năm vào tháng 1 năm sau [borea-hr-performance#c1].": true}, "HB2-18": {"Phụ cấp trực on-call vào ngày thường là 1.500.000 VNĐ/tuần [ankor-engineering-oncall#c3].": true}, "HB2-20": {"Team Lead được phê duyệt chi phí vận hành dưới 10.000.000 VNĐ một giao dịch [ankor-finance-approval-limits#c2].": true}, "HB2-21": {"Ngân sách đào tạo mỗi nhân viên một năm là 10.000.000 VNĐ [ankor-hr-training#c1].": true}, "HB2-22": {"Nhân viên được nghỉ 3 ngày trong dịp lễ Quốc khánh, từ 1 đến 3 tháng 9 [borea-public-holidays#c2].": true}}