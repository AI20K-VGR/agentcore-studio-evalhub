{"HB2-03": {"Tôi không có thông tin cụ thể về số ngày nghỉ Tết Nguyên Đán cho nhân viên từ tài liệu Callisto. Nếu bạn cần thông tin về một công ty hoặc chủ thể cụ thể, xin hãy cung cấp thêm chi tiết hoặc tìm kiếm từ nguồn khác.": false}, "HB2-04": {"Tôi không có thông tin về quy định nghỉ Tết Nguyên Đán của Callisto. Bạn có thể tham khảo tài liệu hoặc chính sách nghỉ lễ của công ty mình để biết thêm chi tiết.": false}, "HB2-06": {"Bảo hiểm sức khoẻ có hạn mức nội trú là 100.000.000 VNĐ/năm [borea-hr-benefits#c1].": true}, "HB2-08": {"Không có thông tin.": false}, "HB2-10": {"Tôi sẽ tra cứu thông tin về đơn xin nghỉ phép. TOOL_CALL: {\"tool\": \"kb_search\", \"params\": {\"query\": \"đơn xin nghỉ phép nộp trước bao lâu\"}}": false}, "HB2-13": {"Chi phí ăn uống công tác nội thành được hoàn ứng tối đa 200.000 VNĐ/bữa [ankor-finance-reimbursement#c2].": true}, "HB2-15": {"Đánh giá hiệu suất diễn ra 2 lần một năm, vào giữa năm (tháng 6) và cuối năm (tháng 12) [ankor-hr-performance#c1].": true}, "HB2-18": {"Phụ cấp trực on-call ngày thường là 1.500.000 VNĐ/tuần [ankor-engineering-oncall#c3].": true}, "HB2-19": {"Không có thông tin về ngày trả lương hàng tháng trong tài liệu Callisto.": false}, "HB2-21": {"Ngân sách đào tạo mỗi nhân viên một năm là 10.000.000 VNĐ [ankor-hr-training#c1].": true}, "HB2-22": {"Nhân viên được nghỉ 3 ngày trong lễ Quốc khánh (từ 1 đến 3/9) [borea-public-holidays#c2].": true}}