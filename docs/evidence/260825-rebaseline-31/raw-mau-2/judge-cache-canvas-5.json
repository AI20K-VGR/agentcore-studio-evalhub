{"HB2-05": {"Bảo hiểm sức khoẻ PVI Care có hạn mức nội trú là 50.000.000 VNĐ/năm [ankor-hr-benefits#c1].": true}, "HB2-06": {"Bảo hiểm sức khỏe của Borea cung cấp hạn mức 100.000.000 VNĐ/năm cho nội trú [borea-hr-benefits#c1].": true}, "HB2-07": {"Sự cố P1 cần phải được xử lý trong vòng 15 phút sau khi đã được xác nhận (acknowledge) trong 5 phút đầu tiên. Tổng thời gian từ khi phát hiện đến khi bắt đầu xử lý là 20 phút [ankor-engineering-oncall#c4].": false}, "HB2-08": {"Sự cố P1 cần phải được xác nhận trong 3 phút, và bắt đầu can thiệp trong 10 phút, với mục tiêu giải quyết trong 30 phút [borea-engineering-oncall#c4].": false}, "HB2-13": {"Chi phí ăn uống công tác nội thành được hoàn ứng tối đa 200.000 VNĐ/bữa [ankor-finance-reimbursement#c2].": true}, "HB2-15": {"Đánh giá hiệu suất diễn ra 2 lần một năm: giữa năm (tháng 6) và cuối năm (tháng 12) [ankor-hr-performance#c1].": true}, "HB2-16": {"Đánh giá hiệu suất diễn ra hằng quý, tức là 4 lần một năm, mỗi đợt kéo dài 2 tuần. Ngoài ra, còn có đánh giá tổng kết năm vào tháng 1 năm sau [borea-hr-performance#c1].": true}, "HB2-18": {"Phụ cấp trực on-call ngày thường là 1.500.000 VNĐ/tuần [ankor-engineering-oncall#c3].": true}, "HB2-20": {"Team Lead được phê duyệt chi phí vận hành dưới 10.000.000 VNĐ một giao dịch. Tổng hạn mức phê duyệt tối đa là 50.000.000 VNĐ một tháng [ankor-finance-approval-limits#c2].": true}, "HB2-21": {"Ngân sách đào tạo mỗi nhân viên Ankor là 10.000.000 VNĐ/năm. [ankor-hr-training#c1]": true}, "HB2-22": {"Nhân viên được nghỉ lễ Quốc khánh 3 ngày, từ 1 đến 3 tháng 9 [borea-public-holidays#c2].": true}}