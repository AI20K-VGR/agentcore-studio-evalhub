{"HB2-06": {"Bảo hiểm sức khoẻ của Borea có hạn mức nội trú là 100.000.000 VNĐ/năm [borea-hr-benefits#c1].": true}, "HB2-07": {"Sự cố P1 cần bắt đầu xử lý trong vòng 15 phút sau khi được ghi nhận (acknowledge) trong 5 phút đầu tiên [ankor-engineering-incident#c6].": true}, "HB2-08": {"Sự cố P1 (Critical) cần được xác nhận trong vòng 3 phút và bắt đầu được xử lý trong 10 phút, với mục tiêu giải quyết trong 30 phút [borea-engineering-oncall#c4].": false}, "HB2-10": {"Không có thông tin.": false}, "HB2-12": {"Quy trình mua sắm áp dụng cho giao dịch từ dưới 30 triệu đến trên 500 triệu, với các cấp phê duyệt tương ứng. Cụ thể, dưới 30 triệu được phê duyệt bởi team lead, từ 30–100 triệu bởi VP, từ 100–500 triệu bởi CFO, và trên 500 triệu phải có sự phê duyệt của CEO và Board [borea-finance-procurement#c4].": false}, "HB2-13": {"Chi phí ăn uống công tác nội thành được hoàn ứng tối đa 200.000 VNĐ/bữa [ankor-finance-reimbursement#c2].": true}, "HB2-15": {"Đánh giá hiệu suất diễn ra 2 lần mỗi năm: giữa năm (tháng 6) và cuối năm (tháng 12) [ankor-hr-performance#c1].": true}, "HB2-18": {"Phụ cấp trực on-call ngày thường là 1.500.000 VNĐ/tuần [ankor-engineering-oncall#c3].": true}, "HB2-21": {"Không có thông tin về ngân sách đào tạo mỗi nhân viên trong tài liệu Callisto.": false}, "HB2-22": {"Nhân viên được nghỉ 3 ngày trong kỳ nghỉ lễ Quốc khánh (từ 1 đến 3/9) [borea-public-holidays#c2].": true}}