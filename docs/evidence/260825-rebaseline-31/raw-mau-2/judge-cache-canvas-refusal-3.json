{"HB2-03": {"Tôi không có thông tin về chính sách nghỉ Tết Nguyên Đán của Callisto. Bạn có thể kiểm tra trong tài liệu hoặc quy định nội bộ của công ty để biết thêm chi tiết.": false}, "HB2-04": {"Không có thông tin.": false}, "HB2-06": {"Bảo hiểm sức khoẻ của Borea có hạn mức nội trú là 100.000.000 VNĐ/năm. [borea-hr-benefits#c1]": true}, "HB2-08": {"Sự cố P1 cần được bắt đầu xử lý trong vòng 3 phút để xác nhận và 10 phút để bắt đầu can thiệp. Thời gian mục tiêu để giải quyết là 30 phút cho những sự cố liên quan đến thanh toán [borea-engineering-oncall#c4].": false}, "HB2-09": {"Tôi sẽ tra cứu thông tin về đơn xin nghỉ phép. \n\nTOOL_CALL: {\"tool\": \"kb_search\", \"params\": {\"query\": \"đơn xin nghỉ phép nộp trước bao lâu\", \"top_k\": 5}}": false}, "HB2-10": {"Không có thông tin.": false}, "HB2-13": {"Chi phí ăn uống công tác nội thành được hoàn ứng tối đa là 200.000 VNĐ/bữa [ankor-finance-reimbursement#c2].": true}, "HB2-15": {"Đánh giá hiệu suất diễn ra 2 lần mỗi năm, cụ thể là vào giữa năm (tháng 6) và cuối năm (tháng 12) [ankor-hr-performance#c1].": true}, "HB2-18": {"Phụ cấp trực on-call ngày thường là 1.500.000 VNĐ/tuần [ankor-engineering-oncall#c3].": true}, "HB2-21": {"Ngân sách đào tạo mỗi nhân viên một năm là 10.000.000 VNĐ [ankor-hr-training#c1].": true}, "HB2-22": {"Nhân viên được nghỉ 3 ngày vào lễ Quốc khánh từ ngày 1 đến ngày 3 tháng 9 [borea-public-holidays#c2].": true}}