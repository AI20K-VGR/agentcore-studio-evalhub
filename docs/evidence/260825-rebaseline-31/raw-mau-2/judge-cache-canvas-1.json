{"HB2-06": {"Bảo hiểm sức khoẻ của Borea có hạn mức nội trú là 100.000.000 VNĐ/năm [borea-hr-benefits#c1].": true}, "HB2-07": {"Sự cố P1 cần được bắt đầu xử lý trong vòng 15 phút sau khi đã được xác nhận (acknowledge trong 5 phút) [ankor-engineering-oncall#c4].": true}, "HB2-08": {"Sự cố P1 cần được xác nhận trong 3 phút và bắt đầu giải quyết trong 10 phút, với mục tiêu giải quyết trong 30 phút [borea-engineering-oncall#c4].": false}, "HB2-13": {"Chi phí ăn uống công tác nội thành được hoàn ứng tối đa 200.000 VNĐ/bữa [ankor-finance-reimbursement#c2].": true}, "HB2-15": {"Đánh giá hiệu suất diễn ra 2 lần một năm: giữa năm (tháng 6) và cuối năm (tháng 12) [ankor-hr-performance#c1].": true}, "HB2-16": {"Đánh giá hiệu suất diễn ra hằng quý (4 lần một năm) và có đánh giá tổng kết năm vào tháng 1 năm sau [borea-hr-performance#c1].": true}, "HB2-18": {"Phụ cấp trực on-call vào ngày thường là 1.500.000 VNĐ/tuần [ankor-engineering-oncall#c3].": true}, "HB2-21": {"Ngân sách đào tạo mỗi nhân viên một năm là 10.000.000 VNĐ [ankor-hr-training#c1].": true}, "HB2-22": {"Nhân viên được nghỉ 3 ngày vào dịp lễ Quốc khánh, từ 1 đến 3/9 [borea-public-holidays#c2].": true}}