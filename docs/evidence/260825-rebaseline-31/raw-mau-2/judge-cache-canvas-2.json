{"HB2-05": {"Bảo hiểm sức khoẻ có hạn mức nội trú là 50.000.000 VNĐ/năm [ankor-hr-benefits#c1].": true}, "HB2-06": {"Bảo hiểm sức khoẻ của Borea có hạn mức nội trú là 100.000.000 VNĐ/năm [borea-hr-benefits#c1].": true}, "HB2-07": {"Sự cố P1 cần bắt đầu xử lý trong vòng 15 phút sau khi đã xác nhận (acknowledge) trong 5 phút [ankor-engineering-oncall#c4].": false}, "HB2-08": {"Sự cố P1 cần được ghi nhận (acknowledge) trong 3 phút và bắt đầu xử lý trong 10 phút, với mục tiêu giải quyết trong 30 phút [borea-engineering-oncall#c4].": false}, "HB2-12": {"Quy trình mua sắm áp dụng cho giao dịch từ 30 triệu đồng trở lên, với các mức phê duyệt khác nhau tùy thuộc vào giá trị giao dịch. Cụ thể, giao dịch dưới 30 triệu cần sự phê duyệt của team lead, từ 30-100 triệu cần sự phê duyệt của VP, từ 100-500 triệu cần sự phê duyệt của CFO, và trên 500 triệu cần sự phê duyệt của CEO cùng Board [borea-finance-procurement#c4].": false}, "HB2-13": {"Chi phí ăn uống công tác nội thành được hoàn ứng tối đa 200.000 VNĐ/bữa [ankor-finance-reimbursement#c2].": true}, "HB2-15": {"Đánh giá hiệu suất diễn ra 2 lần một năm, vào giữa năm (tháng 6) và cuối năm (tháng 12) [ankor-hr-performance#c1].": true}, "HB2-18": {"Phụ cấp trực on-call vào ngày thường là 1.500.000 VNĐ/tuần [ankor-engineering-oncall#c3].": true}, "HB2-20": {"Team Lead được phê duyệt chi phí vận hành tối đa dưới 10.000.000 VNĐ một giao dịch [ankor-finance-approval-limits#c2].": true}, "HB2-22": {"Nhân viên được nghỉ 3 ngày trong dịp Lễ Quốc khánh từ 1 đến 3 tháng 9 [borea-public-holidays#c2].": true}}